<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <com.amazonriver.camera.FaceOverlay
        android:id="@+id/overlay"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/top"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top" android:background="@drawable/scrim_top"
        android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/tvFlash" style="@style/Label"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="FLASH\nOFF" />
            <TextView android:id="@+id/tvTimer" style="@style/Label"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="TIMER\nOFF" />
            <TextView android:id="@+id/tvMenu" style="@style/Label"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="MENU" />
        </LinearLayout>
        <TextView android:id="@+id/tvScene" style="@style/Label"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="24dp" android:textSize="11sp" android:text="" />
    </LinearLayout>

    <TextView android:id="@+id/tvCount" style="@style/Label"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:textSize="96sp"
        android:visibility="gone" />

    <TextView android:id="@+id/tvRotateHint" style="@style/Label"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:textSize="11sp" android:lineSpacingExtra="2dp"
        android:background="#99000000" android:paddingLeft="14dp" android:paddingRight="14dp"
        android:paddingTop="8dp" android:paddingBottom="8dp"
        android:text="ROTATE THE SIDE CAMERA\nTOWARD YOU"
        android:visibility="gone" />

    <TextView android:id="@+id/tvPhoneHint" style="@style/Label"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:textSize="11sp" android:lineSpacingExtra="2dp"
        android:background="#99000000" android:paddingLeft="14dp" android:paddingRight="14dp"
        android:paddingTop="8dp" android:paddingBottom="8dp"
        android:text="PHONE CAMERA\nTAP SHUTTER TO CAPTURE"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bottom"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:background="@drawable/scrim_bottom"
        android:orientation="vertical" android:paddingTop="14dp" android:paddingBottom="8dp">

        <HorizontalScrollView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout android:id="@+id/chips"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingLeft="8dp" android:paddingRight="8dp" />
        </HorizontalScrollView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/tvLens" style="@style/Label"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="LENS" />
            <FrameLayout android:id="@+id/shutter"
                android:layout_width="80dp" android:layout_height="80dp">
                <View android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/shutter_ring" />
                <View android:id="@+id/shutterInner"
                    android:layout_width="58dp" android:layout_height="58dp"
                    android:layout_gravity="center" android:background="@drawable/shutter_dot" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvPhoto" style="@style/Label"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="40dp" android:text="PHOTO" />
                <TextView android:id="@+id/tvVideo" style="@style/Label"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="40dp" android:text="VIDEO" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ScrollView android:id="@+id/panel"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#FFFFFF" android:visibility="gone">
        <LinearLayout android:id="@+id/panelList"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp" />
    </ScrollView>
</FrameLayout>
